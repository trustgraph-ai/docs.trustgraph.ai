---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.html_pages %}{% unless page.sitemap_exclude %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {% if page.last_modified_at %}<lastmod>{{ page.last_modified_at }}</lastmod>
    {% endif %}<changefreq>{{ page.sitemap_changefreq | default: "monthly" }}</changefreq>
    <priority>{{ page.sitemap_priority | default: 0.5 }}</priority>
  </url>
  {% endunless %}{% endfor %}
</urlset>
